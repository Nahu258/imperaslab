---
import { Icon } from 'astro-icon/components';

interface Props {
  eyebrow: string;
  icon: string;
  title: string;
  description?: string;
  align?: 'center' | 'left';
  class?: string;
}

const { eyebrow, icon, title, description, align = 'center', class: className = '' } = Astro.props;
const isCenter = align === 'center';
---

<div class={`${isCenter ? 'text-center max-w-3xl mx-auto' : 'text-left'} ${className}`}>
  <div
    class={`inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#1b1c2b] border border-brand-lavender/20 mb-4 ${isCenter ? '' : 'w-fit'}`}
  >
    <Icon name={icon} class="size-4 text-brand-neon" />
    <span class="font-display text-[11px] uppercase tracking-[0.16em] text-brand-lavender font-semibold">
      {eyebrow}
    </span>
  </div>

  <h2 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-white tracking-tight leading-tight">
    <Fragment set:html={title} />
  </h2>

  {
    description && (
      <p class="mt-4 text-sm sm:text-base text-brand-muted leading-relaxed">{description}</p>
    )
  }
</div>
