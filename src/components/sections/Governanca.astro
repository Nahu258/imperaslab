---
import { Icon } from 'astro-icon/components';
import SectionHeading from '../SectionHeading.astro';

const rules = [
  {
    icon: 'material-symbols:timer',
    title: 'Início em 24 Horas',
    text: 'Infraestrutura técnica e campanhas configuradas em até 1 dia útil após entrega de credenciais e alinhamento do briefing.',
    footer: 'Agilidade Operacional',
    delay: 'reveal-delay-1',
  },
  {
    icon: 'material-symbols:credit-card',
    title: 'Formas de Pagamento',
    text: 'Facilidade total via PIX, cartão de crédito recorrente ou TED corporativa, com emissão obrigatória de Nota Fiscal.',
    footer: 'Compliance Fiscal',
    delay: 'reveal-delay-2',
  },
  {
    icon: 'material-symbols:policy',
    title: 'Política de Reajuste',
    text: 'Reajuste anual padrão pelo índice inflacionário ou proporcional caso o volume de verba gerenciada ultrapasse R$ 10.000/mês.',
    footer: 'Contrato Transparente',
    delay: 'reveal-delay-3',
  },
  {
    icon: 'material-symbols:handshake',
    title: 'Transparência Total',
    text: 'Quaisquer novas demandas não previstas no escopo contratado são orçadas e formalizadas previamente, sem taxas fantasmas.',
    footer: 'Zero Fricção',
    delay: 'reveal-delay-4',
  },
];
---

<section
  id="governanca"
  class="py-24 md:py-32 px-6 lg:px-10 bg-brand-deep border-y border-white/[0.05] relative"
>
  <div class="max-w-6xl mx-auto">
    <SectionHeading
      class="reveal mb-16"
      eyebrow="Governança & SLA"
      icon="material-symbols:verified-user"
      title="Regras do Jogo & Clareza Comercial"
      description="Relacionamentos B2B de alto padrão exigem seriedade, previsibilidade jurídica e ausência total de surpresas."
    />

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        rules.map((rule) => (
          <div class={`reveal ${rule.delay} glass-card rounded-2xl p-6 flex flex-col justify-between`}>
            <div>
              <div class="w-10 h-10 rounded-xl bg-brand-purple/15 border border-brand-purple/30 flex items-center justify-center text-brand-neon mb-4">
                <Icon name={rule.icon} class="size-5" />
              </div>
              <h3 class="font-display font-bold text-base text-white mb-2">{rule.title}</h3>
              <p class="text-xs text-brand-muted leading-relaxed">{rule.text}</p>
            </div>
            <span class="font-display text-[10px] uppercase tracking-wider text-brand-lavender mt-6 block">
              {rule.footer}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>
